APP_NAME=${APP_NAME:-FastAPI Clean Code}
APP_VERSION=${APP_VERSION:-0.1.0}
APP_SECRET_KEY=${APP_SECRET_KEY:-}
APP_JWT_ACCESS_EXPIRES=${APP_JWT_ACCESS_EXPIRES:-900}
APP_JWT_REFRESH_EXPIRES=${APP_JWT_REFRESH_EXPIRES:-604800}
APP_BCRYPT_ROUNDS=${APP_BCRYPT_ROUNDS:-12}
APP_CORS_ORIGINS=${APP_CORS_ORIGINS:-[]}
APP_DOCS_ENABLED=${APP_DOCS_ENABLED:-false}

POSTGRES_HOST=${POSTGRES_HOST:-db}
POSTGRES_PORT=${POSTGRES_PORT:-5432}
POSTGRES_USER=${POSTGRES_USER:-postgres}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-}
POSTGRES_DB=${POSTGRES_DB:-fastapi_clean_code}
